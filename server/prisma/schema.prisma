datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CANDIDATE
  INTERVIEWER
  ADMIN
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum SessionStatus {
  SCHEDULED
  LIVE
  COMPLETED
}

enum SubmissionStatus {
  QUEUED
  PROCESSING
  ACCEPTED
  WRONG_ANSWER
  TIME_LIMIT_EXCEEDED
  MEMORY_LIMIT_EXCEEDED
  RUNTIME_ERROR
  COMPILATION_ERROR
}

model User {
  id                String             @id @default(uuid())
  email             String             @unique
  name              String
  password          String
  role              Role               @default(CANDIDATE)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  interviewsHosted  InterviewSession[] @relation("InterviewerRelation")
  interviewsAttended InterviewSession[] @relation("CandidateRelation")
  submissions       Submission[]

  @@map("users")
}

model Problem {
  id            String             @id @default(uuid())
  title         String
  slug          String             @unique
  description   String             @db.Text
  difficulty    Difficulty         @default(MEDIUM)
  tags          String[]           @default([])
  starterCodes  Json               // e.g. { "python": "...", "javascript": "...", "cpp": "...", "java": "..." }
  timeLimitMs   Int                @default(2000)
  memoryLimitMb Int                @default(128)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  testCases     TestCase[]
  submissions   Submission[]
  sessions      InterviewSession[]

  @@map("problems")
}

model TestCase {
  id             String   @id @default(uuid())
  problemId      String
  input          String   @db.Text
  expectedOutput String   @db.Text
  isHidden       Boolean  @default(false)
  order          Int      @default(0)
  createdAt      DateTime @default(now())

  problem        Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@index([problemId])
  @@map("test_cases")
}

model InterviewSession {
  id            String        @id @default(uuid())
  title         String
  status        SessionStatus @default(LIVE)
  code          String        @default("") @db.Text
  language      String        @default("python")
  interviewerId String
  candidateId   String?
  problemId     String?
  notes         String?       @db.Text
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  interviewer   User          @relation("InterviewerRelation", fields: [interviewerId], references: [id])
  candidate     User?         @relation("CandidateRelation", fields: [candidateId], references: [id])
  problem       Problem?      @relation(fields: [problemId], references: [id])
  submissions   Submission[]

  @@index([interviewerId])
  @@index([candidateId])
  @@map("interview_sessions")
}

model Submission {
  id              String             @id @default(uuid())
  userId          String
  problemId       String
  sessionId       String?
  code            String             @db.Text
  language        String
  status          SubmissionStatus   @default(QUEUED)
  totalTestCases  Int                @default(0)
  passedTestCases Int                @default(0)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem         Problem            @relation(fields: [problemId], references: [id], onDelete: Cascade)
  session         InterviewSession?  @relation(fields: [sessionId], references: [id])
  telemetry       ExecutionTelemetry?

  @@index([userId])
  @@index([problemId])
  @@map("submissions")
}

model ExecutionTelemetry {
  id              String      @id @default(uuid())
  submissionId    String      @unique
  runtimeMs       Float       @default(0)
  memoryKb        Float       @default(0)
  cpuUsagePercent Float       @default(0)
  exitCode        Int         @default(0)
  stdout          String?     @db.Text
  stderr          String?     @db.Text
  testCaseResults Json?       // array of { testCaseId, passed, actualOutput, expectedOutput, executionTimeMs }
  createdAt       DateTime    @default(now())

  submission      Submission  @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@map("execution_telemetry")
}
